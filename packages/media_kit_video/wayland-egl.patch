 #include <gdk/gdkwayland.h>
 #include <gdk/gdkx.h>
 
+// Flutter 3.50+ on Wayland renders through its own EGL subsurface and leaves
+// no context current on the platform thread. EGL hands back the same display
+// for the same platform and wl_display, so mpv's EGLImage still reaches Flutter.
+static EGLDisplay video_output_wayland_egl_display() {
+  GdkDisplay* display = gdk_display_get_default();
+  if (!GDK_IS_WAYLAND_DISPLAY(display)) {
+    return EGL_NO_DISPLAY;
+  }
+  EGLDisplay egl_display = eglGetPlatformDisplayEXT(
+      EGL_PLATFORM_WAYLAND_EXT, gdk_wayland_display_get_wl_display(display),
+      NULL);
+  if (egl_display == EGL_NO_DISPLAY ||
+      !eglInitialize(egl_display, NULL, NULL)) {
+    return EGL_NO_DISPLAY;
+  }
+  return egl_display;
+}
