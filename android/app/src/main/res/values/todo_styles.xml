    </style>
    <style name="TodoAlarmTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF10141B</item>
        <item name="android:statusBarColor">#FF10141B</item>
        <item name="android:navigationBarColor">#FF10141B</item>
    </style>
