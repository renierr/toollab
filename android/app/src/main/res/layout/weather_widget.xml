<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_widget_bg_day"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/weather_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weather_widget_place"
                style="@style/WeatherWidgetValue"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/weather_widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="40sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/weather_widget_condition"
                style="@style/WeatherWidgetSmall"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1" />

            <TextView
                android:id="@+id/weather_widget_range"
                style="@style/WeatherWidgetSmall"
                android:layout_width="match_parent"
                android:gravity="start"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/weather_widget_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:id="@+id/weather_widget_warning"
        style="@style/WeatherWidgetSmall"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:background="@drawable/weather_widget_chip"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/weather_widget_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/weather_widget_h0_time"
                    style="@style/WeatherWidgetSmall" />
                <ImageView
                    android:id="@+id/weather_widget_h0_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginVertical="2dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/weather_widget_h0_temp"
                    style="@style/WeatherWidgetValue" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/weather_widget_h1_time"
                    style="@style/WeatherWidgetSmall" />
                <ImageView
                    android:id="@+id/weather_widget_h1_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginVertical="2dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/weather_widget_h1_temp"
                    style="@style/WeatherWidgetValue" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/weather_widget_h2_time"
                    style="@style/WeatherWidgetSmall" />
                <ImageView
                    android:id="@+id/weather_widget_h2_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginVertical="2dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/weather_widget_h2_temp"
                    style="@style/WeatherWidgetValue" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/weather_widget_h3_time"
                    style="@style/WeatherWidgetSmall" />
                <ImageView
                    android:id="@+id/weather_widget_h3_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginVertical="2dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/weather_widget_h3_temp"
                    style="@style/WeatherWidgetValue" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/weather_widget_h4_time"
                    style="@style/WeatherWidgetSmall" />
                <ImageView
                    android:id="@+id/weather_widget_h4_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginVertical="2dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/weather_widget_h4_temp"
                    style="@style/WeatherWidgetValue" />
            </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weather_widget_days"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/weather_widget_d0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_widget_d0_label"
                style="@style/WeatherWidgetValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start" />
            <ImageView
                android:id="@+id/weather_widget_d0_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weather_widget_d0_low"
                style="@style/WeatherWidgetSmall"
                android:layout_width="44dp"
                android:gravity="end" />
            <TextView
                android:id="@+id/weather_widget_d0_high"
                style="@style/WeatherWidgetValue"
                android:layout_width="44dp"
                android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/weather_widget_d1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_widget_d1_label"
                style="@style/WeatherWidgetValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start" />
            <ImageView
                android:id="@+id/weather_widget_d1_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weather_widget_d1_low"
                style="@style/WeatherWidgetSmall"
                android:layout_width="44dp"
                android:gravity="end" />
            <TextView
                android:id="@+id/weather_widget_d1_high"
                style="@style/WeatherWidgetValue"
                android:layout_width="44dp"
                android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/weather_widget_d2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_widget_d2_label"
                style="@style/WeatherWidgetValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start" />
            <ImageView
                android:id="@+id/weather_widget_d2_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weather_widget_d2_low"
                style="@style/WeatherWidgetSmall"
                android:layout_width="44dp"
                android:gravity="end" />
            <TextView
                android:id="@+id/weather_widget_d2_high"
                style="@style/WeatherWidgetValue"
                android:layout_width="44dp"
                android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/weather_widget_d3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_widget_d3_label"
                style="@style/WeatherWidgetValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start" />
            <ImageView
                android:id="@+id/weather_widget_d3_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weather_widget_d3_low"
                style="@style/WeatherWidgetSmall"
                android:layout_width="44dp"
                android:gravity="end" />
            <TextView
                android:id="@+id/weather_widget_d3_high"
                style="@style/WeatherWidgetValue"
                android:layout_width="44dp"
                android:gravity="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/weather_widget_d4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/weather_widget_d4_label"
                style="@style/WeatherWidgetValue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start" />
            <ImageView
                android:id="@+id/weather_widget_d4_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/weather_widget_d4_low"
                style="@style/WeatherWidgetSmall"
                android:layout_width="44dp"
                android:gravity="end" />
            <TextView
                android:id="@+id/weather_widget_d4_high"
                style="@style/WeatherWidgetValue"
                android:layout_width="44dp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/weather_widget_empty"
        style="@style/WeatherWidgetValue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/weather_widget_no_data"
        android:visibility="gone" />

    <TextView
        android:id="@+id/weather_widget_updated"
        style="@style/WeatherWidgetSmall"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:gravity="end"
        android:textSize="10sp" />
</LinearLayout>
